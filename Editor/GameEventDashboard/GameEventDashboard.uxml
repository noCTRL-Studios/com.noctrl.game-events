<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <ui:VisualElement name="EventMetricControls" style="flex-grow: 0; top: auto; flex-direction: row; flex-shrink: 0;">
        <ui:Label text="Event Metric Controls" parse-escape-sequences="false" style="justify-content: center; align-items: center; align-self: center;"/>
        <ui:Button text="Clear Json Data" name="ClearMetricData" style="flex-direction: row;"/>
        <ui:Button text="Open Folder" name="OpenMetricFolder"/>
        <ui:Button text="Reset" triple-click-selects-line="false" name="ResetButton"/>
    </ui:VisualElement>
    <ui:VisualElement name="PlaySessionElements" style="flex-grow: 0; flex-direction: row;">
        <ui:DropdownField label="Play Session" name="PlaySessionDropDown" style="flex-direction: row; flex-wrap: nowrap; width: 323px;"/>
    </ui:VisualElement>
    <ui:VisualElement name="SessonEventElements" style="flex-grow: 1; flex-direction: row;">
        <ui:DropdownField label="Session Event" name="SessionEventDropDown" style="width: 323px;"/>
    </ui:VisualElement>
    <ui:VisualElement name="PlaySessionView" style="flex-grow: 1;">
        <ui:MultiColumnListView columns="" sort-column-descriptions="" fixed-item-height="20" name="PlaySessionListView" show-alternating-row-backgrounds="All" reorder-mode="Simple" style="height: 235px; width: 486px;">
            <ui:Columns>
                <ui:Column name="TimeStamp" title="Time Stamp" width="auto" stretchable="true" visible="true"/>
                <ui:Column name="NumberListeners" title="Number Of Listeners" stretchable="true" width="auto"/>
            </ui:Columns>
        </ui:MultiColumnListView>
    </ui:VisualElement>
    <ui:VisualElement name="GameEventControls" style="flex-grow: 1; flex-direction: row;">
        <ui:Label text="Game Event Controls" style="flex-direction: column; justify-content: flex-end; align-content: auto; align-self: center; align-items: auto;"/>
        <ui:Button text="Create New Event" name="GameEventCreateButton"/>
    </ui:VisualElement>
    <ui:VisualElement name="GameEventView" style="flex-grow: 1;">
        <ui:MultiColumnListView columns="" sort-column-descriptions="" name="GameEventListView" reorderable="false" show-alternating-row-backgrounds="ContentOnly" fixed-item-height="20" style="height: 215px;">
            <ui:Columns>
                <ui:Column name="EventName" title="Game Event Name" stretchable="true"/>
                <ui:Column name="NumberOfListeners" title="Number Of Active Listeners" stretchable="true"/>
            </ui:Columns>
        </ui:MultiColumnListView>
    </ui:VisualElement>
</ui:UXML>
